# Nixite AI Bridge systemd service file
# This service runs the AI-powered bridge for intelligent package search
#
# Installation:
#   1. Copy this file to /etc/systemd/system/nixite-bridge.service
#   2. Update the paths below to match your installation
#   3. Run: sudo systemctl daemon-reload
#   4. Run: sudo systemctl enable nixite-bridge
#   5. Run: sudo systemctl start nixite-bridge
#
# Note: This service requires Node.js and is optional.
# Nixite will work without it using fallback knowledge base mode.

[Unit]
Description=Nixite AI Bridge - Intelligent Package Search
Documentation=https://github.com/Luminous-Dynamics/nixite
After=network.target
Requires=nixite.service

[Service]
Type=simple
User=nixite
Group=nixite
WorkingDirectory=/opt/nixite

# Start the AI bridge
ExecStart=/usr/bin/node /opt/nixite/nixite-luminous-bridge.js

# Restart policy
Restart=on-failure
RestartSec=10s

# Environment
Environment="NODE_ENV=production"
Environment="BRIDGE_PORT=8890"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nixite

# Resource limits
MemoryLimit=1G
CPUQuota=75%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nixite-bridge

[Install]
WantedBy=multi-user.target
