# EditorConfig for Nixite
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript
[*.js]
indent_style = space
indent_size = 2
quote_type = single

# JSON files
[*.json]
indent_style = space
indent_size = 2

# JSON with comments (config files)
[*.jsonc]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# HTML files
[*.html]
indent_style = space
indent_size = 2

# CSS files
[*.css]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Bash scripts
[*.bash]
indent_style = space
indent_size = 2

# Nix files
[*.nix]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Makefile (must use tabs)
[Makefile]
indent_style = tab

# Package files
[{package.json,package-lock.json}]
indent_style = space
indent_size = 2

# Configuration files
[{.babelrc,.stylelintrc,.eslintrc,tsconfig.json}]
indent_style = space
indent_size = 2

# Docker files
[{Dockerfile,docker-compose.yml}]
indent_style = space
indent_size = 2

# Caddyfile
[Caddyfile]
indent_style = space
indent_size = 2
# Note: tabs are also acceptable in Caddyfile

# nginx conf
[*.conf]
indent_style = space
indent_size = 2

# Git commit messages
[COMMIT_EDITMSG]
max_line_length = 72

# Git config
[.gitconfig]
indent_style = tab

# Ignore files
[{.gitignore,.dockerignore}]
indent_size = 2
