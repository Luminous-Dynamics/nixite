    // ========================================
    {
      "label": "Check Production Readiness",
      "type": "shell",
      "command": "./scripts/deploy.sh check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    // ========================================
    // Documentation Tasks
    // ========================================
    {
      "label": "Open Documentation",
      "type": "shell",
      "command": "xdg-open docs/README.md || open docs/README.md || start docs/README.md",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
