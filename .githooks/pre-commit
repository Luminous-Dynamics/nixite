#!/bin/bash
#
# Nixite Pre-Commit Hook
#
# This hook validates code before allowing commits.
# It checks:
# - JSON syntax (config, packages)
# - JavaScript syntax
# - Package data integrity
# - Configuration validity
#
# Installation:
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use git config:
#   git config core.hooksPath .githooks
#
# To bypass (use sparingly):
#   git commit --no-verify
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}Nixite Pre-Commit Validation${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Track errors
ERRORS=0

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to print status
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓${NC} $2"
    else
        echo -e "${RED}✗${NC} $2"
        ERRORS=$((ERRORS + 1))
    fi
}

# Check Node.js availability
if ! command_exists node; then
    echo -e "${YELLOW}⚠${NC} Node.js not found, skipping advanced validations"
    echo -e "${YELLOW}  Install Node.js for full validation support${NC}"
    SKIP_NODE=1
else
    SKIP_NODE=0
fi

# 1. Validate JSON files
echo -e "${BLUE}[1/5]${NC} Validating JSON files..."

# Check nixite-packages.json
if [ -f "nixite-packages.json" ]; then
    if command_exists jq; then
        jq . nixite-packages.json > /dev/null 2>&1
        print_status $? "nixite-packages.json"
    else
        node -e "JSON.parse(require('fs').readFileSync('nixite-packages.json', 'utf8'))" 2>/dev/null
        print_status $? "nixite-packages.json"
    fi
else
    echo -e "${YELLOW}⚠${NC} nixite-packages.json not found"
fi

# Check package.json
if [ -f "package.json" ]; then
    if command_exists jq; then
        jq . package.json > /dev/null 2>&1
        print_status $? "package.json"
    else
        node -e "JSON.parse(require('fs').readFileSync('package.json', 'utf8'))" 2>/dev/null
        print_status $? "package.json"
    fi
fi

echo ""

# 2. Validate JavaScript files
echo -e "${BLUE}[2/5]${NC} Validating JavaScript syntax..."

JS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$')

if [ -z "$JS_FILES" ]; then
    echo -e "${BLUE}ℹ${NC} No JavaScript files to check"
else
    for file in $JS_FILES; do
        if [ -f "$file" ]; then
            node -c "$file" 2>/dev/null
            print_status $? "$file"
        fi
    done
fi

echo ""

# 3. Validate package data (if changed)
echo -e "${BLUE}[3/5]${NC} Validating package data..."

if echo "$JS_FILES" | grep -q "nixite-packages.json" || [ "$1" = "--full" ]; then
    if [ $SKIP_NODE -eq 0 ] && [ -f "scripts/validate-packages.js" ]; then
        node scripts/validate-packages.js nixite-packages.json > /tmp/nixite-package-validation.log 2>&1
        if [ $? -eq 0 ]; then
            print_status 0 "Package data validation"
        else
            print_status 1 "Package data validation"
            echo -e "${YELLOW}  See /tmp/nixite-package-validation.log for details${NC}"
        fi
    else
        echo -e "${BLUE}ℹ${NC} Skipping package validation (validator not available)"
    fi
else
    echo -e "${BLUE}ℹ${NC} Package file not changed, skipping validation"
fi

echo ""

# 4. Validate configuration (if changed)
echo -e "${BLUE}[4/5]${NC} Validating configuration..."

if echo "$JS_FILES" | grep -q "config.js" || [ "$1" = "--full" ]; then
    if [ $SKIP_NODE -eq 0 ] && [ -f "scripts/validate-config.js" ] && [ -f "config.js" ]; then
        node scripts/validate-config.js config.js > /tmp/nixite-config-validation.log 2>&1
        if [ $? -eq 0 ]; then
            print_status 0 "Configuration validation"
        else
            print_status 1 "Configuration validation"
            echo -e "${YELLOW}  See /tmp/nixite-config-validation.log for details${NC}"
        fi
    else
        echo -e "${BLUE}ℹ${NC} Skipping config validation (validator not available or no config.js)"
    fi
else
    echo -e "${BLUE}ℹ${NC} Config file not changed, skipping validation"
fi

echo ""

# 5. Check for common issues
echo -e "${BLUE}[5/5]${NC} Checking for common issues..."

# Check for console.log in production code (warning only)
CONSOLE_LOGS=$(git diff --cached | grep -c '^\+.*console\.log')
if [ $CONSOLE_LOGS -gt 0 ]; then
    echo -e "${YELLOW}⚠${NC} Found $CONSOLE_LOGS console.log statements in staged changes"
    echo -e "${YELLOW}  Consider removing them before committing${NC}"
fi

# Check for TODO/FIXME comments being added
TODO_COUNT=$(git diff --cached | grep -c '^\+.*\(TODO\|FIXME\)')
if [ $TODO_COUNT -gt 0 ]; then
    echo -e "${YELLOW}⚠${NC} Found $TODO_COUNT TODO/FIXME comments in staged changes"
fi

# Check file sizes
LARGE_FILES=$(git diff --cached --name-only | while read file; do
    if [ -f "$file" ]; then
        size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)
        if [ $size -gt 1000000 ]; then  # 1MB
            echo "$file ($((size / 1024))KB)"
        fi
    fi
done)

if [ ! -z "$LARGE_FILES" ]; then
    echo -e "${YELLOW}⚠${NC} Large files detected:"
    echo "$LARGE_FILES" | while read line; do
        echo -e "${YELLOW}  - $line${NC}"
    done
fi

if [ $CONSOLE_LOGS -eq 0 ] && [ $TODO_COUNT -eq 0 ] && [ -z "$LARGE_FILES" ]; then
    print_status 0 "No common issues found"
fi

echo ""

# Final result
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}✓ All validations passed!${NC}"
    echo -e "${GREEN}  Proceeding with commit...${NC}"
    exit 0
else
    echo -e "${RED}✗ Found $ERRORS error(s)${NC}"
    echo -e "${RED}  Please fix the errors above before committing${NC}"
    echo ""
    echo -e "${YELLOW}  To bypass this hook (not recommended):${NC}"
    echo -e "${YELLOW}    git commit --no-verify${NC}"
    exit 1
fi
