# Caddyfile - Caddy Reverse Proxy Configuration for Nixite
#
# Caddy automatically handles HTTPS with Let's Encrypt!
# Much simpler than nginx while still being production-ready.
#
# Features:
# - Automatic HTTPS/SSL with Let's Encrypt
# - HTTP/2 and HTTP/3 support
# - Compression
# - Security headers
# - Rate limiting
# - Simple configuration
#
# Installation:
#   1. Install Caddy: https://caddyserver.com/docs/install
#   2. Place this file as /etc/caddy/Caddyfile (or ./Caddyfile for development)
#   3. Update nixite.example.com to your domain
#   4. Start Caddy: systemctl start caddy (or caddy run for development)
#   5. Caddy automatically obtains SSL certificate!
#
# Usage:
#   systemctl start caddy      # Start Caddy
#   systemctl reload caddy     # Reload after changes
#   systemctl stop caddy       # Stop Caddy
#   caddy fmt --overwrite      # Format this file
#   caddy run                  # Run in foreground (development)

# Global options
{
    # Email for Let's Encrypt
    email admin@example.com

    # Automatic HTTPS
    auto_https on

    # Admin API (localhost only)
    admin localhost:2019

    # Logging
    log {
        output file /var/log/caddy/nixite.log {
            roll_size 10MB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

# Main site
nixite.example.com {
    # Automatic HTTPS - Caddy handles this!

    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"

        # XSS protection
        X-XSS-Protection "1; mode=block"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy
        Permissions-Policy "geolocation=(), microphone=(self), camera=()"

        # Content Security Policy (adjust as needed)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.example.com;"

        # Remove server header (security)
        -Server
    }

    # Enable gzip/br compression
    encode {
        gzip 6
        zstd
        minimum_length 256
    }

    # Rate limiting (10 requests per second)
    rate_limit {
        zone static_rl {
            key {remote_host}
            events 10
            window 1s
        }
    }

    # Logging for this site
    log {
        output file /var/log/caddy/nixite-access.log {
            roll_size 10MB
            roll_keep 10
        }
        format json
    }

    # Main application
    reverse_proxy /* localhost:8000 {
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 5s

        # Header pass-through
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Timeouts
        transport http {
            dial_timeout 10s
            response_header_timeout 30s
        }
    }

    # AI Bridge API endpoint
    handle /api/bridge/* {
        reverse_proxy localhost:8890 {
            # Longer timeout for AI processing
            transport http {
                dial_timeout 15s
                response_header_timeout 120s
                read_timeout 120s
            }

            # Strip /api/bridge prefix
            rewrite * {path}
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static file caching
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # JSON data caching (shorter)
    @json {
        path *.json
    }
    header @json {
        Cache-Control "public, max-age=3600"
    }

    # Health check endpoint (no logging)
    handle /health {
        reverse_proxy localhost:8000 {
            health_uri /health
        }
        log {
            output discard
        }
    }
}

# Development configuration (comment out for production)
# localhost:8000 {
#     reverse_proxy localhost:8000
#     reverse_proxy /api/bridge/* localhost:8890
# }

# HTTP-only development (no HTTPS)
# :8080 {
#     reverse_proxy localhost:8000
#     reverse_proxy /api/bridge/* localhost:8890
# }
